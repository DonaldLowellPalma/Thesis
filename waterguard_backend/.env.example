# Server Configuration
PORT=4000

# JWT Configuration
JWT_SECRET=change-this-secret-in-production-use-a-strong-random-string
JWT_EXPIRES_IN=7d

# Firebase Admin SDK Configuration
# IMPORTANT: Get these from Firebase Console > Project Settings > Service Accounts
# 1. Go to https://console.firebase.google.com/project/YOUR_PROJECT/settings/serviceaccounts/adminsdk
# 2. Click "Generate Key" button
# 3. Copy the values below from the downloaded JSON file
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_YOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# SMTP Email Configuration
# Used to send password-change confirmation emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM="WaterGuard <no-reply@waterguard.com>"

# Device Token Configuration
# For Firestore direct writes, devices request short-lived tokens from backend.
# Option 1: Single shared secret for all devices
DEVICE_SECRET=your-shared-device-secret-here
# Option 2: Per-device secrets (comma-separated: deviceId:secret,deviceId2:secret2)
# DEVICE_SECRETS=device-001:secret123,device-002:secret456
